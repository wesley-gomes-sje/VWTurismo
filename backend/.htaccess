RewriteEngine On

# Passa o header Authorization para o PHP (Apache geralmente o remove)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Não redireciona arquivos ou diretórios reais
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Encaminha tudo para index.php preservando REQUEST_URI
RewriteRule ^(.*)$ index.php [QSA,L]

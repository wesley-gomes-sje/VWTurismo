{
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Controller\\": "Controller/",
            "App\\View\\": "View/",
            "App\\Middleware\\": "middlewares/",
            "App\\Database\\": "Database/"
        },
        "classmap": [
            "connection.php",
            "Model/"
        ],
        "files": [
            "auth.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
